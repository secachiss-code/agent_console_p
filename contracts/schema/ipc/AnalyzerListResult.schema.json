        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "version"
      ],
      "title": "AnalyzerItem",
      "type": "object"
    },
    "AnalyzerListResult": {
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "items": {
