            "$ref": "#/$defs/AnalyzerItem"
          },
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "title": "AnalyzerListResult",
      "type": "object"
    }
  },
  "$ref": "#/$defs/AnalyzerListResult",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
