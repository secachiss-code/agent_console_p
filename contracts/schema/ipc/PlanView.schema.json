{
  "$defs": {
    "AgentKind": {
      "enum": [
        "claude",
        "codex",
        "cursor",
        "grok",
        "opencode"
      ],
      "title": "AgentKind"
    },
    "NodeStatus": {
      "enum": [
        "blocked",
        "cancelled",
        "done",
        "failed",
        "in_progress",
        "pending",
        "verifying"
      ],
      "title": "NodeStatus"
    },
    "PlanNodeView": {
      "properties": {
        "attempt_no": {
          "default": 0,
          "type": "integer"
        },
        "depends_on": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "last_verdict": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "layer": {
          "type": "integer"
        },
        "lease_expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "level": {
          "default": 1,
          "enum": [
            0,
            1
          ]
        },
        "max_attempts": {
          "default": 4,
          "type": "integer"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "owner_agent": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "parent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pipeline": {
          "default": false,
          "type": "boolean"
        },
        "priority": {
          "type": "number"
        },
        "ready": {
          "type": "boolean"
        },
        "related": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/NodeStatus"
        },
        "tab_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "key",
        "title",
        "status",
        "ready",
        "layer",
        "priority",
        "depends_on",
        "owner_agent",
        "tab_id",
        "lease_expires_at",
        "note"
      ],
      "title": "PlanNodeView",
      "type": "object"
    },
    "PlanView": {
      "properties": {
        "canvas": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "done": {
          "type": "integer"
        },
        "goal": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/PlanNodeView"
          },
          "type": "array"
        },
        "phase": {
          "default": "draft",
          "enum": [
            "completed",
            "draft",
            "frozen"
          ]
        },
        "project_id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "active",
            "archived",
            "completed"
          ]
        },
        "title": {
          "type": "string"
        },
        "total": {
          "type": "integer"
        },
        "updated_at": {
          "format": "date-time",
          "type": "string"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "project_id",
        "title",
        "goal",
        "status",
        "nodes",
        "done",
        "total",
        "canvas",
        "updated_at"
      ],
      "title": "PlanView",
      "type": "object"
    }
  },
  "$ref": "#/$defs/PlanView",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
