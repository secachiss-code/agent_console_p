          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "key": {
          "maxLength": 10,
          "minLength": 3,
          "type": "string"
        },
        "level": {
          "default": 1,
          "enum": [
            0,
            1
          ]
        },
        "objective": {
          "maxLength": 2000,
          "type": "string"
        },
        "output_format": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
