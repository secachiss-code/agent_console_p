          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "type": "array"
        },
        "boundaries": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "depends_on": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "type": "array"
        },
        "gate_profile": {},
