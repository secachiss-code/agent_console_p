{
  "$defs": {
    "Settings": {
      "properties": {
        "approval_hold_seconds": {
          "default": 540,
          "maximum": 540,
          "minimum": 30,
          "type": "integer"
        },
        "approvals_mode": {
          "default": "inline",
          "enum": [
            "inline",
            "native"
          ]
        },
        "checkpoints_enabled": {
          "default": true,
          "type": "boolean"
        },
        "checkpoints_keep": {
          "default": 100,
          "maximum": 500,
          "minimum": 5,
          "type": "integer"
        },
        "codegraph_languages": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "keymap_overrides": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "type": "object"
        },
        "notify_when": {
          "default": "unfocused",
          "enum": [
            "always",
            "never",
            "unfocused"
          ]
        },
        "quota_critical_pct": {
          "default": 95,
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        "quota_warn_pct": {
          "default": 80,
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        "rev": {
          "type": "integer"
        },
        "scrollback_lines": {
          "default": 20000,
          "maximum": 200000,
          "minimum": 1000,
          "type": "integer"
        },
        "setup_completed": {
          "default": false,
          "type": "boolean"
        },
        "terminal_font": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "terminal_font_size": {
          "default": 11,
          "maximum": 32,
          "minimum": 8,
          "type": "integer"
        },
        "theme": {
          "default": "system",
          "enum": [
            "dark",
            "light",
            "system"
          ]
        },
        "vault_path": {
          "type": "string"
        },
        "worktrees_dir": {
          "type": "string"
        }
      },
      "required": [
        "rev",
        "vault_path",
        "worktrees_dir"
      ],
      "title": "Settings",
      "type": "object"
    }
  },
  "$ref": "#/$defs/Settings",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
