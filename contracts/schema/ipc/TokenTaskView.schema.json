          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "model": {
          "type": "string"
        },
        "open": {
          "default": false,
          "type": "boolean"
        },
        "spent_tokens": {
          "type": "integer"
        },
        "window_pct": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "model",
        "spent_tokens"
      ],
      "title": "TokenTaskView",
      "type": "object"
    }
  },
  "$ref": "#/$defs/TokenTaskView",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
