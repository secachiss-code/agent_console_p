    "QuotaLevel": {
      "enum": [
        "critical",
        "ok",
        "unknown",
        "warn"
      ],
      "title": "QuotaLevel"
    },
    "QuotaWindowView": {
      "properties": {
        "estimated": {
          "type": "boolean"
        },
        "key": {
          "enum": [
            "5h",
            "7d",
            "budget",
            "month",
            "week"
          ]
        },
        "level": {
          "$ref": "#/$defs/QuotaLevel"
        },
        "limit_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
