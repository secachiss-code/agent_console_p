{
  "$defs": {
    "ModelUsageView": {
      "description": "Tokens one model used. `cost_usd` only when the agent reports it.",
      "properties": {
        "cache_read_tokens": {
          "type": "integer"
        },
        "cache_write_tokens": {
          "type": "integer"
        },
        "cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "input_tokens": {
          "type": "integer"
        },
        "model": {
          "type": "string"
        },
        "output_tokens": {
          "type": "integer"
        }
      },
      "required": [
        "model",
        "input_tokens",
        "output_tokens",
        "cache_read_tokens",
        "cache_write_tokens"
      ],
      "title": "ModelUsageView",
      "type": "object"
    }
  },
  "$ref": "#/$defs/ModelUsageView",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
