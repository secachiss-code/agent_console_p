{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "evidence": {
      "anyOf": [
        {
          "maxLength": 4000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence"
    },
    "fence": {
      "title": "Fence",
      "type": "integer"
    },
    "node_id": {
      "title": "Node Id",
      "type": "string"
    },
    "note": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    },
    "status": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Status"
    }
  },
  "required": [
    "node_id",
    "fence"
  ],
  "title": "NodeUpdateIn",
  "type": "object"
}
