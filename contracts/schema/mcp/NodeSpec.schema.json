{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "acceptance": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Acceptance",
      "type": "array"
    },
    "boundaries": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Boundaries"
    },
    "depends_on": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Depends On",
      "type": "array"
    },
    "key": {
      "pattern": "^[A-Z]{1,4}-\\d{1,4}$",
      "title": "Key",
      "type": "string"
    },
    "objective": {
      "maxLength": 2000,
      "title": "Objective",
      "type": "string"
    },
    "output_format": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Format"
    },
    "owner_agent": {
      "anyOf": [
        {
          "enum": [
            "claude",
            "codex"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Owner Agent"
    },
    "parent": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent"
    },
    "paths": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Paths",
      "type": "array"
    },
    "related": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Related",
      "type": "array"
    },
    "review_required": {
      "default": false,
      "title": "Review Required",
      "type": "boolean"
    },
    "test_cmd": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Test Cmd"
    },
    "title": {
      "maxLength": 120,
      "minLength": 3,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "key",
    "title",
    "objective"
  ],
  "title": "NodeSpec",
  "type": "object"
}
