        },
        "paths": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Paths",
          "type": "array"
        },
        "related": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Related",
          "type": "array"
        },
        "review_required": {
          "default": false,
          "title": "Review Required",
          "type": "boolean"
        },
        "test_cmd": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
