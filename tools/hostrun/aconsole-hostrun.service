[Unit]
Description=AConsole hostrun whitelist executor
# Install: sed "s|@REPO@|$PWD|" tools/hostrun/aconsole-hostrun.service > ~/.config/systemd/user/aconsole-hostrun.service

[Service]
Type=simple
WorkingDirectory=@REPO@
ExecStart=/usr/bin/env python3 @REPO@/tools/hostrun/server.py
Restart=on-failure
RestartSec=1
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
