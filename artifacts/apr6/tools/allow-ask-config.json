{
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "pwd",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git status",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git diff",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git log",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git branch",
      "effect": "allow"
    }
  ],
  "update": "disable",
  "model": "anthropic/claude-sonnet-4-6",
  "providers": {
    "anthropic": {
      "settings": {
        "baseURL": "http://127.0.0.1:36885/v1",
        "apiKey": "probe-only"
      }
    }
  }
}
