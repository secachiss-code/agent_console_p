        async def check(pane: GitPane, toasts: list[str], _window: Adw.ApplicationWindow) -> None:
            await _select(pane, "work side")
            before = _git(tree, "rev-parse", "HEAD")
            _press(pane, "rebase")
            _answer(pane)
            await _settled(lambda: (tree / ".git").exists() and bool(toasts))
